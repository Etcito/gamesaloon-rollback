  "description": "Generic, game-agnostic deterministic rollback netcode: fixed tick, snapshot ring, resimulation, desync detection and resync. Pure TypeScript, zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./netsim": "./src/netsim.ts"
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
