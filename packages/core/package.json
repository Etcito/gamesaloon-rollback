{
  "name": "@gamesaloon/rollback",
  "version": "0.1.0",
  "description": "Generic, game-agnostic deterministic rollback netcode: fixed tick, snapshot ring, resimulation, desync detection and resync. Pure TypeScript, zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./netsim": {
      "types": "./dist/netsim.d.ts",
      "default": "./dist/netsim.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs dist",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Etcito/gamesaloon-rollback",
    "directory": "packages/core"
  }
}
